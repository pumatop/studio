rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Banners are publicly readable.
    // Writes are allowed for any authenticated user. For production, restrict this further.
    match /banners/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // App update files are publicly readable.
    // Writes are allowed for any authenticated user. For production, restrict this further.
    match /app_updates/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // User-specific verification files.
    // Users can upload their own verification documents.
    match /verification/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notification images are publicly readable.
    // Admin users can write to this path.
    match /notification-images/{allPaths=**} {
        allow read;
        allow write: if request.auth != null;
    }
  }
}
