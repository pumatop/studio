rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Banners are publicly readable, but only admins can upload/delete.
    match /banners/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && root.child('users').child(request.auth.uid).child('role').val() == 'admin';
    }

    // User-specific verification files.
    // Users can upload their own verification documents.
    match /verification/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
