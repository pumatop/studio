rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Receipts folder for transaction proof - Allowed for authenticated users (Admins/Supervisors)
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Banners are publicly readable.
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // App update files are publicly readable.
    match /app_updates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User-specific verification files.
    match /verification/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notification images are publicly readable.
    match /notification-images/{allPaths=**} {
        allow read: if true;
        allow write: if request.auth != null;
    }
    
    // Deployment Trigger Comment: Force Rules Update 1772668000000
  }
}