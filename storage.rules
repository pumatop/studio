
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // تحديث رقم: 1772671000000 - إضافة قاعدة الإيصالات وحل مشكلة الأذونات
    
    // البانرات الإعلانية متاحة للقراءة للجميع والكتابة للمسؤولين
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ملفات تحديث التطبيق
    match /app_updates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ملفات توثيق المستخدمين
    match /verification/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // صور الإشعارات
    match /notification-images/{allPaths=**} {
        allow read: if true;
        allow write: if request.auth != null;
    }

    // مجلد الإيصالات - ضروري جداً لعملية تأكيد التحويل
    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
