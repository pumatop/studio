rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Banners are publicly readable.
    // For production, you should restrict write access to admins only,
    // likely using a Cloud Function or custom claims, as Storage Rules
    // cannot directly read from the Realtime Database to check a user's role.
    match /banners/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // User-specific verification files.
    // Users can upload their own verification documents.
    match /verification/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
