{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["phone", "role", "status", "verification"],
      
      "$uid": {
        "transactions": {
          ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".indexOn": ["type", "status", "timestamp", "delegateId", "recipientId"]
        },
        "notifications": {
            ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
            ".indexOn": ["createdAt"]
        }
      }
    },
    
    "supervisors": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["status", "connectionStatus"]
    },
    "exchangeRates": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["currencyPair"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "appVersions": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "exchangeRateLogs": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["date"]
    },
    "fakkaSafe": {
      ".read": "auth != null",
      ".write": false
    },
    "dailyAggregates": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["totalEgpAmount"]
    },
    "notifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["createdAt"]
    }
  }
}
