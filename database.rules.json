{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["phone", "role", "status", "verification"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "transactions": {
      ".read": "auth != null",
      ".indexOn": ["userId", "senderId", "type"],
       "$transactionId": {
         ".write": false
       }
    }
  }
}
