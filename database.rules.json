
{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["phone", "role", "status", "verification"],
      "$uid": {
        ".write": "auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin'",
        "transactions": {
          ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin')",
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin')",
          ".indexOn": ["type", "status", "timestamp", "delegateId", "recipientId", "transferMethod", "recipientNumber"]
        }
      }
    },
    "supervisors": {
      ".read": "auth != null",
      ".indexOn": ["status", "connectionStatus"],
      "$uid": {
        ".write": "(root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin') || (auth.uid == $uid && !data.exists())"
      }
    },
    "admin": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin' || root.child('users').child(auth.uid).child('role').val() == 'merchant' || root.child('supervisors').child(auth.uid).exists())",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin' || root.child('users').child(auth.uid).child('role').val() == 'merchant' || root.child('supervisors').child(auth.uid).exists())",
      "pending_egypt_transfers": {
        ".indexOn": ["status", "timestamp", "transferMethod", "userId"]
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'superadmin'"
    },
    "exchangeRateLogs": {
      ".read": "auth != null",
      ".indexOn": ["date"]
    },
    "dailyAggregates": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
